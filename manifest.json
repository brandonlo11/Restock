{
  "manifest_version": 3,
  "name": "Stock Monitor",
  "version": "1.0",
  "description": "Monitor product stock and get notified when items are back in stock",
  "permissions": [
    "storage",
    "notifications",
    "activeTab",
    "alarms"
  ],
  "host_permissions": [
    "*://*/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/restock_logo_16x16.png",
      "48": "icons/restock_logo_48x48.png",
      "128": "icons/restock_logo_128x128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*/*"],
      "js": ["content.js"]
    }
  ],
  "icons": {
    "16": "icons/restock_logo_16x16.png",
    "48": "icons/restock_logo_48x48.png",
    "128": "icons/restock_logo_128x128.png"
  }
}